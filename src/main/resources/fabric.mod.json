{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": ["${authors}"],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${sources}"
  },
  "license": "${license}",
  "icon": "assets/${modId}/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "dev.missy.switchy_puffish_skills.client.SwitchyPuffishSkillsClient"
    ],
    "main": [
      "dev.missy.switchy_puffish_skills.SwitchyPuffishSkills"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "fabric": ">=${fabricApi}",
    "minecraft": ">=${mc}",
    "puffish_skills": ">=0.16.6",
    "switchy-core": ">=${switchy}",
    "switchy-client": ">=${switchy}",
    "switchy-cardinal": ">=${switchy}",
    "switchy-ui": ">=${switchy}"
  }
}
